# ==========================================
# FACTORY SUITE PRO - BACKEND (.env.example)
# This is a template/example showing all required variable keys.
# ==========================================

# Server Settings
PORT=5000
NODE_ENV=production
CORS_ORIGIN=*

# Google API Credentials (Hidden from Browser)
REACT_APP_GOOGLE_API_KEY=YOUR_GOOGLE_SHEETS_API_KEY

# Spreadsheet IDs
REACT_APP_MAIN_SPREADSHEET_ID=YOUR_MAIN_SPREADSHEET_ID
REACT_APP_JOBORDER_SPREADSHEET_ID=YOUR_JOBORDER_SPREADSHEET_ID
REACT_APP_ISSUES_SPREADSHEET_ID=YOUR_ISSUES_SPREADSHEET_ID
REACT_APP_DAILY_STITCHING_SPREADSHEET_ID=YOUR_DAILY_STITCHING_SPREADSHEET_ID
REACT_APP_WORKING_UPDATES_SPREADSHEET_ID=YOUR_WORKING_UPDATES_SPREADSHEET_ID
REACT_APP_ZIP_SPREADSHEET_ID=YOUR_ZIP_SPREADSHEET_ID
REACT_APP_DORI_SPREADSHEET_ID=YOUR_DORI_SPREADSHEET_ID
REACT_APP_RAWPACK_SPREADSHEET_ID=YOUR_RAWPACK_SPREADSHEET_ID
REACT_APP_LOT_LOGS_SPREADSHEET_ID=YOUR_LOT_LOGS_SPREADSHEET_ID
REACT_APP_CREDENTIALS_SPREADSHEET_ID=YOUR_CREDENTIALS_SPREADSHEET_ID
REACT_APP_KNITTING_SPREADSHEET_ID=YOUR_KNITTING_SPREADSHEET_ID
REACT_APP_EMB_PRINT_REMARKS_SPREADSHEET_ID=YOUR_EMB_PRINT_REMARKS_SPREADSHEET_ID

# Google Apps Script Webhooks
REACT_APP_LOT_LOGS_WEBHOOK_URL=YOUR_LOT_LOGS_WEBHOOK_URL
REACT_APP_EMB_PRINT_REMARKS_WEBHOOK_URL=YOUR_EMB_PRINT_REMARKS_WEBHOOK_URL

# Caching Strategy (in seconds)
CACHE_TTL=60
